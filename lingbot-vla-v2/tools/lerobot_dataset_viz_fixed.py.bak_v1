import torch

import lerobot.scripts.lerobot_dataset_viz as viz


class FixedEpisodeSampler(torch.utils.data.Sampler):
    """
    Workaround for LeRobot 0.4.2 dataset-viz bug.

    lerobot-dataset-viz creates a LeRobotDataset filtered to one episode,
    but the original EpisodeSampler still uses global dataset frame indices.

    For a dataset already filtered to one episode, local indices must be:
        0 ... len(dataset)-1
    """

    def __init__(self, dataset, episode_index):
        episodes = getattr(dataset, "episodes", None)

        if episodes is not None and len(episodes) == 1:
            self.frame_ids = range(len(dataset))
        else:
            from_idx = dataset.meta.episodes[
                "dataset_from_index"
            ][episode_index]
            to_idx = dataset.meta.episodes[
                "dataset_to_index"
            ][episode_index]

            self.frame_ids = range(from_idx, to_idx)

    def __iter__(self):
        return iter(self.frame_ids)

    def __len__(self):
        return len(self.frame_ids)


# Replace only the buggy sampler.
# Do not modify the installed LeRobot package.
viz.EpisodeSampler = FixedEpisodeSampler


if __name__ == "__main__":
    viz.main()
